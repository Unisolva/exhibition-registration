# Environment files and secrets (never published)
.env*
!.env.example
secrets/
*.inv
docs/installations/

# Database dumps
*.sql
*.sql.gz

# Dependencies and build output
/vendor
/node_modules
/build
release-*.tgz

# Runtime state (folder skeleton kept by the .gitignore files inside)
/storage/*.key
/bootstrap/cache/*.php

# Browser test output and local fixtures (generated passwords, saved sessions)
/tests/Browser/test-results
/tests/Browser/playwright-report
/tests/Browser/fixtures.json
/tests/Browser/.auth
/tests/Browser/node_modules

# Tooling
*.log
.phpunit.result.cache
/.phpunit.cache
/.idea
/.vscode
.DS_Store
Thumbs.db
